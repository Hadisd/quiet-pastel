{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "quiet-pastel",
  "name": "Quiet Pastel",
  "version": "1.1.2",
  "execution": "data",
  "description": "Two dark, pale blue-violet themes with pastel accents and matching terminal themes: Quiet Pastel Moonlit (brighter) and Quiet Pastel Hush (dimmer).",
  "license": "MIT",
  "repository": "https://github.com/Hadisd/quiet-pastel",
  "engines": {
    "orca": ">=1.4.246"
  },
  "cover": {
    "path": "images/cover.png",
    "alt": "Quiet Pastel Moonlit preview: a file tree, syntax-highlighted TypeScript, terminal output and palette swatches"
  },
  "contributes": {
    "themes": [
      {
        "id": "moonlit-pastel",
        "title": "Quiet Pastel Moonlit",
        "path": "themes/moonlit-pastel.json"
      },
      {
        "id": "quiet-pastel",
        "title": "Quiet Pastel Hush",
        "path": "themes/quiet-pastel.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "moonlit-pastel",
        "title": "Quiet Pastel Moonlit Terminal",
        "path": "terminal/moonlit-pastel.json"
      },
      {
        "id": "quiet-pastel",
        "title": "Quiet Pastel Hush Terminal",
        "path": "terminal/quiet-pastel.json"
      }
    ]
  },
  "capabilities": []
}
